# Required: PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/notion_blog
SPRING_DATASOURCE_USERNAME=notion_blog
SPRING_DATASOURCE_PASSWORD=replace-me

# Required: Notion source connection
NOTION_TOKEN=replace-me
NOTION_SETTINGS_DATA_SOURCE_ID=00000000000000000000000000000000

# Optional: server and Notion client defaults are shown explicitly here.
SERVER_PORT=8080
NOTION_SOURCE_ID=notion
NOTION_API_VERSION=2026-03-11
NOTION_BASE_URL=https://api.notion.com/v1
NOTION_REQUEST_TIMEOUT=10s
NOTION_COLLECTION_TIMEOUT=30s
NOTION_MAX_BLOCK_DEPTH=32
NOTION_MAX_BLOCK_COUNT=10000

# Optional: overrides the default public blog origin. Set an empty value to disable RSS.
BLOG_PUBLIC_BASE_URL=https://blog.homelab.robinjoon.xyz

# Optional: synchronization defaults.
BLOG_SYNCHRONIZATION_ENABLED=true
BLOG_SYNCHRONIZATION_INTERVAL_MS=60000
BLOG_SYNCHRONIZATION_DUE_BATCH_SIZE=100
BLOG_SYNCHRONIZATION_SUCCESS_INTERVAL=5m
BLOG_SYNCHRONIZATION_INITIAL_FAILURE_DELAY=5s
BLOG_SYNCHRONIZATION_MAXIMUM_FAILURE_DELAY=5m
